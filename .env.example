# AgentScope self-host defaults (copy to .env for local Compose use).
# Do not commit real credentials or production connection strings.
AGENTSCOPE_WEB_PORT=8080
AGENTSCOPE_API_PORT=8000
DATABASE_URL=sqlite:////app/data/agentscope.db

# Optional PostgreSQL profile (compose --profile postgres up)
POSTGRES_DB=agentscope
POSTGRES_USER=agentscope
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://agentscope:change-me-locally@postgres:5432/agentscope
